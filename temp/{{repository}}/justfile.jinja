# Import environment variables from .env files in repo
set dotenv-load := true

# Define specific variables for just to use in the justfiles
PACKAGE := "{{package}}"
REPOSITORY := "{{repository}}"
SOURCES := "src"
TESTS := "tests"

# Define default command when user types just in terminal
default:
    @just --list

# Import defined justfiles
import 'automation/docker.just'
import 'automation/document.just'
import 'automation/package.just'
import 'automation/quality.just'
import 'automation/setup.just'
import 'automation/version.just'
